pipeline {
  agent any

  parameters {
    booleanParam(
      name: 'APPLY',
      defaultValue: false,
      description: 'Run terraform apply'
    )
  }

environment {
  TF_WORKDIR = "/workspace/${JOB_NAME}"
  GITHUB_REPOSITORY = sh(
    script: "git config --get remote.origin.url | sed -E 's#.*github.com[:/](.+)/(.+)(\\.git)?#\\1/\\2#'",
    returnStdout: true
  ).trim()
}

  stages {

    stage('Terraform Init') {
      steps {
        sh '''
          docker exec terraform sh -c "
            cd ${TF_WORKDIR} &&
            terraform init
          "
        '''
      }
    }

    stage('Terraform Plan') {
      steps {
        sh '''
          docker exec terraform sh -c "
            cd ${TF_WORKDIR} &&
            terraform plan -out=tfplan
          "
        '''
      }
    }

    stage('Checkov Scan') {
      steps {
        sh '''
          docker exec terraform sh -c "
            cd ${TF_WORKDIR} &&
            terraform show -json tfplan > plan.json &&
            checkov \
              --framework terraform_plan \
              --file plan.json \
              --output json \
              --soft-fail > checkov.json
          "
        '''
      }
    }

stage('Summarize Checkov Results') {
  steps {
    sh '''
      docker exec terraform sh -c "cd ${TF_WORKDIR} && cp checkov.json /tmp/checkov.json"

      cat <<'EOF' | jq -r - /tmp/checkov.json > comment.txt
.summary as $s |
"🔐 Checkov Security Scan Results\n\n" +
"Critical: \($s.critical)\n" +
"High: \($s.high)\n" +
"Medium: \($s.medium)\n\n" +
"Top issues:\n" +
(
  .results.failed_checks
  | sort_by(.severity)
  | .[:5]
  | map("- \(.check_id): \(.check_name)")
  | join("\n")
)
EOF
    '''
  }
}


    stage('Comment Results on Main Commit') {
      when {
        branch 'main'
      }
      steps {
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
          sh '''
            COMMENT=$(docker exec terraform sh -c "cd ${TF_WORKDIR} && cat comment.txt" | jq -Rs .)

            curl -X POST \
              -H "Authorization: Bearer $GITHUB_TOKEN" \
              -H "Accept: application/vnd.github+json" \
              https://api.github.com/repos/${GITHUB_REPOSITORY}/commits/${GIT_COMMIT}/comments \
              -d "{\"body\": $COMMENT}"
          '''
        }
      }
    }

    stage('Terraform Apply') {
      when {
        expression { params.APPLY }
      }
      steps {
        sh '''
          docker exec terraform sh -c "
            cd ${TF_WORKDIR} &&
            terraform apply -auto-approve tfplan
          "
        '''
      }
    }
  }
}
